import * as Phaser from 'phaser'
import { TEXTURE } from '../constants'
import { JINX_SPELL_VFX } from './jinxSpellVfxConfig'
import { hasJinxSpellTexture } from './loadJinxSpellVfx'

type Scene = Phaser.Scene

const ADD = Phaser.BlendModes.ADD
const NORMAL = Phaser.BlendModes.NORMAL

/** `Jinx_Base_R_Mis` → emisor Projected → birthColor constantValue (RGBA 0–1). */
const R_PROJECTED_TINT = 0xff4d05
const R_PROJECTED_ALPHA = 0.38
/** Temp_GroundGlow birthColor. */
const R_SHAPE_TINT = 0xff7d31
const R_SHAPE_ALPHA = 0.35
/** FakeShadow birthColor (Aura_Self, blend 1). */
const R_SHADOW_TINT = 0x05050d

export function spawnWImpactVisual(scene: Scene, x: number, y: number, depth: number) {
  const authentic = hasJinxSpellTexture(scene, 'wSparks')
  const key = authentic ? JINX_SPELL_VFX.wSparks : TEXTURE.zapHit
  const hit = scene.add.image(x, y, key)
  hit.setDepth(depth + 1)
  hit.setOrigin(0.5, 0.5)
  hit.setBlendMode(ADD)
  hit.setScale(authentic ? 0.22 : 0.65)
  hit.setAlpha(0.92)
  scene.tweens.add({
    targets: hit,
    alpha: 0,
    scale: hit.scale * 1.25,
    duration: 120,
    onComplete: () => hit.destroy(),
  })
}

export type ChomperTrapVisual = Phaser.GameObjects.Container & {
  chomperBody?: Phaser.GameObjects.Image
  chomperBlur?: Phaser.GameObjects.Image
}

/** E idle: Grenade (NORMAL) + Grenade_Blur (ADD), como `Jinx_Base_E_Mis`. */
export function createChomperTrapVisual(
  scene: Scene,
  x: number,
  y: number,
  depth: number,
): ChomperTrapVisual {
  const root = scene.add.container(x, y) as ChomperTrapVisual
  root.setDepth(depth)

  const useAuthentic = hasJinxSpellTexture(scene, 'eGrenade')
  if (useAuthentic) {
    if (hasJinxSpellTexture(scene, 'eGrenadeBlur')) {
      const blur = scene.add.image(0, 0, JINX_SPELL_VFX.eGrenadeBlur)
      blur.setOrigin(0.5, 0.55)
      blur.setBlendMode(ADD)
      blur.setAlpha(0.55)
      blur.setScale(0.52)
      root.add(blur)
      root.chomperBlur = blur
    }

    const body = scene.add.image(0, 0, JINX_SPELL_VFX.eGrenade)
    body.setOrigin(0.5, 0.55)
    body.setBlendMode(NORMAL)
    body.setAlpha(1)
    body.setScale(0.5)
    root.add(body)
    root.chomperBody = body
  } else {
    const fallback = scene.add.image(0, 0, TEXTURE.chomperTrap)
    fallback.setOrigin(0.5, 0.55)
    fallback.setScale(0.95)
    root.add(fallback)
    root.chomperBody = fallback
  }

  return root
}

/** Animación suave del halo Grenade_Blur (alpha over lifetime aproximado). */
export function updateChomperTrapVisualIdle(trap: ChomperTrapVisual, timeMs: number) {
  trap.chomperBody?.setAlpha(1)
  if (trap.chomperBlur) {
    trap.chomperBlur.setAlpha(0.42 + Math.sin(timeMs / 280) * 0.22)
  }
}

export function spawnChomperTriggerVisual(scene: Scene, x: number, y: number, depth: number) {
  const key = hasJinxSpellTexture(scene, 'eSplat')
    ? JINX_SPELL_VFX.eSplat
    : TEXTURE.chomperTrap
  const splat = scene.add.image(x, y, key)
  splat.setDepth(depth + 2)
  splat.setOrigin(0.5, 0.5)
  splat.setScale(hasJinxSpellTexture(scene, 'eSplat') ? 0.35 : 0.7)
  splat.setAlpha(0.78)
  splat.setBlendMode(hasJinxSpellTexture(scene, 'eSplat') ? ADD : NORMAL)
  scene.tweens.add({
    targets: splat,
    alpha: 0,
    scale: splat.scale * 1.2,
    duration: 200,
    onComplete: () => splat.destroy(),
  })
}

/**
 * R: atlas `jinx_r_mis.png` es UV de malla — cuerpo opaco = fallback hasta bake.
 * Capas 2D de `Jinx_Base_R_Mis`: sombra, glow shape, aura projected, estela.
 */
export function createRMissileVisual(
  scene: Scene,
  x: number,
  y: number,
  angle: number,
  depth: number,
): Phaser.GameObjects.Container {
  const root = scene.add.container(x, y)
  root.setRotation(angle)
  root.setDepth(depth)

  if (hasJinxSpellTexture(scene, 'rAuraSelf')) {
    const shadow = scene.add.image(-4, 2, JINX_SPELL_VFX.rAuraSelf)
    shadow.setOrigin(0.5, 0.5)
    shadow.setBlendMode(NORMAL)
    shadow.setTint(R_SHADOW_TINT)
    shadow.setAlpha(0.85)
    shadow.setScale(0.2)
    root.add(shadow)
  }

  if (hasJinxSpellTexture(scene, 'rShapeGlow')) {
    const shapeBase = scene.add.image(0, 0, JINX_SPELL_VFX.rShapeGlow)
    shapeBase.setOrigin(0.5, 0.5)
    shapeBase.setBlendMode(NORMAL)
    shapeBase.setTint(R_SHAPE_TINT)
    shapeBase.setAlpha(R_SHAPE_ALPHA)
    shapeBase.setScale(0.14)
    root.add(shapeBase)

    const shapeAdd = scene.add.image(0, 0, JINX_SPELL_VFX.rShapeGlow)
    shapeAdd.setOrigin(0.5, 0.5)
    shapeAdd.setBlendMode(ADD)
    shapeAdd.setTint(R_SHAPE_TINT)
    shapeAdd.setAlpha(R_SHAPE_ALPHA * 0.95)
    shapeAdd.setScale(0.15)
    root.add(shapeAdd)
  }

  const body = scene.add.image(0, 0, TEXTURE.megaRocket)
  body.setOrigin(0.5, 0.5)
  body.setBlendMode(NORMAL)
  body.setAlpha(1)
  body.setScale(1.25)
  root.add(body)

  if (hasJinxSpellTexture(scene, 'rAuraSelf')) {
    const projected = scene.add.image(2, 0, JINX_SPELL_VFX.rAuraSelf)
    projected.setOrigin(0.5, 0.5)
    projected.setBlendMode(ADD)
    projected.setTint(R_PROJECTED_TINT)
    projected.setAlpha(R_PROJECTED_ALPHA)
    projected.setScale(0.22)
    root.add(projected)
  }

  return root
}

export function spawnRTrailPuff(scene: Scene, x: number, y: number, depth: number) {
  if (!hasJinxSpellTexture(scene, 'rRocketFire')) {
    return
  }
  const puff = scene.add.image(x, y, JINX_SPELL_VFX.rRocketFire)
  puff.setDepth(depth - 1)
  puff.setOrigin(0.5, 0.5)
  puff.setScale(0.12)
  puff.setAlpha(0.55)
  puff.setBlendMode(ADD)
  scene.tweens.add({
    targets: puff,
    alpha: 0,
    scale: 0.18,
    duration: 180,
    onComplete: () => puff.destroy(),
  })
}
